<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="repository.latinboy" name="Latin Boy Repository" version="1.0.0" provider-name="Latinboy">
        

    
        <extension point="xbmc.addon.repository" name="Latin Boy Repository">
            
        
            <dir>
                
            
                <info compressed="false">https://latinboykodi.github.io/addons.xml</info>
                
            
                <checksum>https://latinboykodi.github.io/addons.xml.md5</checksum>
                
            
                <datadir zip="true">https://latinboykodi.github.io/zips/</datadir>
                
        
            </dir>
            
    
        </extension>
        

    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Repositorio oficial de Latinboy</summary>
            
        
            <summary lang="en">Latinboy Official Repository</summary>
            
        
            <description lang="es">Addons y herramientas desarrolladas por Latinboy para Kodi.</description>
            
        
            <description lang="en">Addons and tools developed by Latinboy for Kodi.</description>
            
        
            <platform>all</platform>
            
        
            <license>GPL-2.0-only</license>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
            
                <fanart>fanart.jpg</fanart>
                
        
            </assets>
            
    
        </extension>
        


    </addon>
    <addon id="plugin.program.latinboy" name="Latin Boy Wizard" version="1.1.0" provider-name="Slam, Sarge, Funsterbe, BYB, Zaxxon709, LatinBoy">
        
	
        <requires>
            
		
            <import addon="xbmc.python" version="3.0.0"/>
            
	
        </requires>
        
	
        <extension point="xbmc.python.pluginsource" library="addon.py">
            
		
            <provides>executable</provides>
            
	
        </extension>
        
	
        <extension point="xbmc.service" library="service.py"/>
        
	
        <extension point="xbmc.addon.metadata">
            
		
            <summary lang="en_GB">Latin Boy Wizard</summary>
            
		
            <description lang="en_GB">Una versión simple de simple</description>
            
		
            <disclaimer lang="en_GB">Este complemento no contiene contenido.</disclaimer>
            
		
            <language>en</language>
            
		
            <platform>all</platform>
            
		
            <license>GPL-2.0-or-later</license>
            
		
            <forum/>
            
		
            <website/>
            
		
            <email/>
            
		
            <source/>
            
		
            <news/>
            
		
            <assets>
                
			
                <icon>icon.png</icon>
                
			
                <fanart>fanart.jpg</fanart>
                
		
            </assets>
            
	
        </extension>
        

    </addon>
</addons>